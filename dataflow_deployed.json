    "scriptLines": [
      "source(output(",
      "          order_id as string,",
      "          customer_id as string,",
      "          product as string,",
      "          quantity as integer,",
      "          unit_price as decimal(10,0)",
      "     ),",
      "     allowSchemaDrift: true,",
      "     validateSchema: false,",
      "     ignoreNoFilesFound: false) ~> source1",
      "WindowDetectDuplicates split(isNull(customer_id) || trim(customer_id) == '' || isNull(quantity) || quantity <= 0 || isNull(unit_price) || unit_price <= 0 || duplicate_rank > 1,",
      "     disjoint: false) ~> invalidRecords@(invalidRecords, validRecords)",
      "source1 window(over(customer_id,",
      "          product,",
      "          quantity,",
      "          unit_price),",
      "     asc(order_id, true),",
      "     duplicate_rank = rowNumber()) ~> WindowDetectDuplicates",
      "invalidRecords@validRecords sink(allowSchemaDrift: true,",
      "     validateSchema: false,",
      "     umask: 0022,",
      "     preCommands: [],",
      "     postCommands: [],",
      "     skipDuplicateMapInputs: true,",
      "     skipDuplicateMapOutputs: true,",
      "     partitionBy('hash', 1)) ~> sinkValidRecords",
      "invalidRecords@invalidRecords sink(allowSchemaDrift: true,",
      "     validateSchema: false,",
      "     umask: 0022,",
      "     preCommands: [],",
      "     postCommands: [],",
      "     skipDuplicateMapInputs: true,",
      "     skipDuplicateMapOutputs: true,",
      "     partitionBy('hash', 1)) ~> sinkInvalidRecords"
