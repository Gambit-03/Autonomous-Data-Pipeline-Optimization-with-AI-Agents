{
  "name": "PL_PipelineFailureAgentProbe",
  "properties": {
    "annotations": ["Controlled failure-analysis test"],
    "activities": [
      {
        "name": "CopyMissingTestFile",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "DelimitedTextSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false,
              "enablePartitionDiscovery": false
            },
            "formatSettings": {
              "type": "DelimitedTextReadSettings",
              "skipLineCount": 0
            }
          },
          "sink": {
            "type": "DelimitedTextSink",
            "storeSettings": { "type": "AzureBlobFSWriteSettings" },
            "formatSettings": {
              "type": "DelimitedTextWriteSettings",
              "fileExtension": ".txt"
            }
          },
          "dataIntegrationUnits": 4,
          "parallelCopies": 1,
          "enableStaging": false,
          "validateDataConsistency": false,
          "translator": { "type": "TabularTranslator", "typeConversion": true }
        },
        "inputs": [
          { "referenceName": "DS_FailureProbeSource", "type": "DatasetReference" }
        ],
        "outputs": [
          { "referenceName": "DS_FailureProbeSink", "type": "DatasetReference" }
        ]
      }
    ]
  }
}
